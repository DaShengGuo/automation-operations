# 抖音自动化运营 — 环境配置
# 复制此文件为 .env 后填写实际值

# ADB 设备序列号 (通过 adb devices 查看)
DOUYIN_DEVICE=

# MuMu 模拟器 ADB 地址 (默认 127.0.0.1:7555)
MUMU_ADB_ADDR=127.0.0.1:7555

# ADB 可执行文件路径 (留空自动查找)
ADB_PATH=

# Web Dashboard 端口
DASHBOARD_PORT=5800

# AI 视频筛选 (默认关闭, 需要下载模型)
AI_ENABLED=false

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
